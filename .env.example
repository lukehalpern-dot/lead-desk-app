# Copy this file to .env for local development.
# On Render, you'll set these as "Environment Variables" in the dashboard instead of using this file.

# Required: connection string from your Supabase project
# (Supabase dashboard -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Optional for now: leave blank to keep "Find leads" disabled.
# Add this later (get one at console.anthropic.com) to turn live search on.
ANTHROPIC_API_KEY=

# Optional: Render sets this automatically. Only needed for local dev if you want a non-default port.
PORT=3000
